# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
**/.aws-sam/
.newsletter-private/
# Private owner snapshots/configuration are never website artifacts.
.newsletter-backup-private/
*.cvnb
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Supabase CLI local state
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# Local verification evidence (independent of Next build output)
.verification/
baseline-*.log
baseline-*.tap
cleanup-*.log
.verification-package-lock.log

# Local AWS authentication, SAM state, private deployment inputs and releases.
**/.aws/
/~/
**/samconfig.toml
**/samconfig.*.toml
**/credentials
**/credentials.json
**/aws-credentials*.json
**/parameters.private.json
**/parameters*.local.json
**/*private*parameters*.json
**/disabled-parameters.json
**/discovery-disabled-parameters.json
/release/
/releases/
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.pfx
*.p12
*.key
