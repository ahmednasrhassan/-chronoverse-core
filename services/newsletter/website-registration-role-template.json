{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Source-only website registration ingress with exact team OIDC provider and production project role. Separate owner approval required; does not change newsletter resources or gates.",
  "Parameters": {
    "TeamSlug": { "Type": "String", "Default": "chronoverse-capital", "AllowedValues": ["chronoverse-capital"] },
    "ProjectName": { "Type": "String", "Default": "chronoverse-capital", "AllowedValues": ["chronoverse-capital"] }
  },
  "Resources": {
    "WebsiteOidcProvider": {
      "Type": "AWS::IAM::OIDCProvider",
      "Properties": {
        "Url": { "Fn::Sub": "https://oidc.vercel.com/${TeamSlug}" },
        "ClientIdList": [{ "Fn::Sub": "https://vercel.com/${TeamSlug}" }]
      }
    },
    "WebsiteRegistrationRole": {
      "Type": "AWS::IAM::Role",
      "DependsOn": "WebsiteOidcProvider",
      "Properties": {
        "RoleName": "chronoverse-newsletter-website-registration",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Fn::Sub": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Federated\":\"arn:aws:iam::957261948953:oidc-provider/oidc.vercel.com/${TeamSlug}\"},\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Condition\":{\"StringEquals\":{\"oidc.vercel.com/${TeamSlug}:aud\":\"https://vercel.com/${TeamSlug}\",\"oidc.vercel.com/${TeamSlug}:sub\":\"owner:${TeamSlug}:project:${ProjectName}:environment:production\"}}}]}"
        },
        "Policies": [{
          "PolicyName": "only-newsletter-registration",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [{
              "Effect": "Allow",
              "Action": "execute-api:Invoke",
              "Resource": "arn:aws:execute-api:eu-north-1:957261948953:lh71lvbqi8/$default/POST/register"
            }]
          }
        }]
      }
    }
  },
  "Outputs": {
    "RoleArn": { "Value": { "Fn::GetAtt": ["WebsiteRegistrationRole", "Arn"] } },
    "ProviderArn": { "Value": { "Ref": "WebsiteOidcProvider" } }
  }
}
